# Copy to `.env` and fill in. The real `.env` is hard-linked into each stack
# directory, so edit it in place (append, or an editor that keeps the inode)
# rather than replacing the file.
#
# Values with `$` in them (e.g. bcrypt hashes) go in single quotes so Docker
# Compose doesn't try to interpolate them.

## General
# PUID=1001
# PGID=999
TZ=America/Edmonton
# LOCAL_DOMAIN_NAME=hostname.lan
# LOCAL_HOST_IP=192.168.1.x
# PUBLIC_DOMAIN_NAME=public.example.com
# DOCKER_USERDIR=/home/docker  # holds compose/, build/, volumes/, backup/
# DOCKER_EXTRA_DIR=
# DOCKER_EXTRA_2_DIR=
# NAS_DIR=
# NETWORK_INTERFACE=eth0  # parent interface for the meta_vlan macvlan network
# IP6_GATEWAY=

## Frontend (Traefik)
# TRAEFIK_ACME_EMAIL=

## DDNS
# DDNS_UPDATE_URL=
# DDNS_KEY_NORMANDIE=
# DDNS_KEY_AB=
# DDNS_KEY_AUDIOBOOKS=
# DDNS_KEY_BOOKS=
# DDNS_KEY_BOOKSONIC=
# DDNS_KEY_CHAT=
# DDNS_KEY_HOME_ASSISTANT=
# DDNS_KEY_HASS_MCP_LOGS=
# DDNS_KEY_MUSIC=
# DDNS_KEY_VAULT=
# DDNS_KEY_VIDEO=
# BAFFINISLAND_PUBLIC_DOMAIN_NAME=
# BAFFINISLAND_PRIVATE_IP=
# DDNS_KEY_BAFFINISLAND=

## Bitwarden (Vaultwarden)
# BITWARDEN_ADMIN_TOKEN=

## Home Assistant
# MYSQL_ROOT_PASSWORD=   # hass_db; also used by db-backup
# MYSQL_USER_PASSWORD=
# HASS_MCP_LOGS_HA_TOKEN=
# HASS_MCP_LOGS_MCP_TOKEN=
# HASS_MCP_LOGS_MCP_PATH=
# HASS_MCP_LOGS_PUBLIC_URL=
# ZWAVE_SESSION_SECRET=   # signs zwave-js-ui web sessions; openssl rand -hex 32

## Immich
# IMMICH_VERSION=release
# IMMICH_DB_DATABASE_NAME=immich
# IMMICH_DB_USERNAME=postgres
# IMMICH_DB_PASSWORD=
# IMMICH_API_KEY=         # for immich-power-tools
# IMMICH_URL_INTERNAL=
# IMMICH_URL_EXTERNAL=

## Media
# QBT_PORT=9932
# RADARR_API_KEY=         # for unpackerr
# SONARR_API_KEY=         # for unpackerr
# FLARESOLVERR_LOG_LEVEL=info
# FLARESOLVERR_LOG_HTML=false
# FLARESOLVERR_CAPTCHA_SOLVER=none

